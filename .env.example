FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///instance/minyi.db

# 正式上線時（Render / Railway）請改設定為平台提供的 Postgres 連線字串，
# 例如：postgresql://user:password@host:5432/dbname
# 並在平台環境變數中設定一組獨立、隨機產生的 SECRET_KEY

# 後台管理帳號存放在資料表 admin_users，新增帳號或重設密碼：
#   flask --app run set-admin 帳號
# 以下兩個變數只在第一次建立 admin_users 資料表時匯入一次，之後修改不會生效
ADMIN_USERNAME=admin
# 密碼雜湊值，勿填明碼。產生方式：
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('你的密碼'))"
ADMIN_PASSWORD_HASH=

# 作品圖片 / 影片上傳至 Supabase Storage（未設定則存在本機 app/static/uploads）
# SUPABASE_URL：Project Settings → API 的 Project URL，例如 https://xxxx.supabase.co
#   （不要填 Storage 設定頁的 S3 端點 .../storage/v1/s3；多填的路徑會被自動忽略）
# SUPABASE_SERVICE_KEY：Project Settings → API Keys 的 secret key（sb_secret_ 開頭）或舊版 service_role key，切勿公開
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=works
